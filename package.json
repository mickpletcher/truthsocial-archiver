{
  "name": "truth-social-archive-desktop",
  "productName": "Truth Social Archive",
  "version": "1.0.1",
  "description": "Searchable desktop archive of Donald J. Trump's public Truth Social posts.",
  "main": "desktop/main.js",
  "author": "Mick Pletcher",
  "license": "MIT",
  "scripts": {
    "start": "node node_modules/@electron-forge/cli/dist/electron-forge.js start",
    "package": "node node_modules/@electron-forge/cli/dist/electron-forge.js package",
    "make": "node node_modules/@electron-forge/cli/dist/electron-forge.js make",
    "lint": "npm run lint:js && npm run lint:markdown",
    "lint:js": "node node_modules/eslint/bin/eslint.js .",
    "lint:markdown": "node node_modules/markdownlint-cli2/markdownlint-cli2-bin.mjs README.md assessment.md changelog.md completed-upgrades.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md SUPPORT.md ACCESSIBILITY.md .github/PULL_REQUEST_TEMPLATE.md",
    "test": "node --test tests/*.test.js",
    "test:powershell": "pwsh -NoProfile -File scripts/Invoke-PesterTests.ps1",
    "test:electron": "node scripts/test-electron.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "check": "npm run lint && npm test",
    "postinstall": "node scripts/patch-appdmg.mjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@eslint/js": "10.0.1",
    "electron": "45.2.3",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "markdownlint-cli2": "0.24.0",
    "playwright": "1.65.0"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "markdownlint": {
      "re2js": "2.8.7"
    },
    "glob@>=9.0.0 <=14.0.1": "14.0.3",
    "minimatch@>=7.0.0 <11.0.1": "11.0.4",
    "katex@<0.18.2": "0.18.2",
    "appdmg": {
      "image-size": "2.0.4"
    }
  }
}
